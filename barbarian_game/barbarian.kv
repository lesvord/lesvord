#:kivy 2.2.1

<GameScreen>:
    canvas.before:
        Color:
            rgba: 0.08, 0.09, 0.11, 1
        Rectangle:
            pos: self.pos
            size: self.size
    BarbarianSprite:
        id: hero
        size: dp(42), dp(42)
        pos: root.game_state.barbarian.position
    BoxLayout:
        size_hint_y: None
        height: dp(72)
        pos_hint: {"x": 0, "top": 1}
        padding: dp(12)
        spacing: dp(12)
        canvas.before:
            Color:
                rgba: 0.05, 0.05, 0.07, 0.9
            Rectangle:
                pos: self.pos
                size: self.size
        ProgressBar:
            id: stamina_bar
            max: 100
            value: root.game_state.barbarian.stamina
        ProgressBar:
            id: rage_bar
            max: 100
            value: root.game_state.barbarian.rage
        Label:
            text: f"Уровень {root.game_state.barbarian.level}"
            size_hint_x: None
            width: dp(90)
    Label:
        id: message
        text: root.game_state.message
        size_hint_y: None
        height: dp(40)
        pos_hint: {"x": 0.05, "y": 0.01}
        color: 1, 1, 0.9, 1

<BarbarianSprite@Widget>:
    canvas:
        Color:
            rgba: 0.85, 0.3, 0.25, 1
        Ellipse:
            pos: self.pos
            size: self.size
        Color:
            rgba: 0.2, 0.1, 0.05, 1
        Rectangle:
            pos: self.x + self.width * 0.25, self.y + self.height * 0.25
            size: self.width * 0.5, self.height * 0.5

<ObjectiveMarker@Widget>:
    color: 0.5, 0.7, 1, 1
    text: "?"
    canvas:
        Color:
            rgba: self.color
        Ellipse:
            pos: self.pos
            size: self.size
        Color:
            rgba: 0, 0, 0, 0.6
        Line:
            width: 1.3
            ellipse: self.x, self.y, self.width, self.height
